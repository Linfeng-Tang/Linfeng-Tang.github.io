{% capture footer_contents %}
  <div class="footer-shell">
    <div class="footer-copy">
      <span class="footer-mark">LT</span>
      <div>
        <p class="footer-title">{{ site.first_name }} {{ site.last_name }}</p>
        <p class="footer-subtitle">Academic homepage focused on image fusion, restoration, and visual perception.</p>
      </div>
    </div>
    <div class="footer-meta">
      <span>&copy; {{ site.time | date: '%Y' }} {{ site.first_name }} {{ site.middle_name }} {{ site.last_name }}</span>
      {% if site.last_updated %}
        <span>Updated {{ 'now' | date: '%B %d, %Y' }}</span>
      {% endif %}
      <span>{{ site.footer_text }}</span>
      {% if site.impressum_path %}
        <a href="{{ site.url }}{{ site.baseurl }}{{ site.impressum_path }}">Impressum</a>
      {% endif %}
    </div>
  </div>
{% endcapture %}

{% if site.footer_fixed %}
  <footer class="fixed-bottom" role="contentinfo">
    <div class="container mt-0">
      {{ footer_contents }}
    </div>
  </footer>
{% else %}
  <footer class="sticky-bottom mt-5" role="contentinfo">
    {% if site.newsletter.enabled %}
      {% include newsletter.liquid %}
    {% endif %}

    <div class="container">
      {{ footer_contents }}
    </div>
  </footer>
{% endif %}
